{
  "info": {
    "name": "nlsearch",
    "description": "Talk to Elasticsearch in plain English through the _nl endpoint.\n\nSet the host variable to your node. Every answer carries \"response\", a sentence a \nperson can read, and \"result\", what Elasticsearch returned. Send \"response\": \"explain\" \nfor the sentence alone or \"raw\" for the data alone. The requests under \"Chat bots: \nsessions and history\" are meant to be run in order; they share the session variable \nand show how a conversation is kept.\n\nhttps://smsian.github.io/nlsearch/",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:9200",
      "type": "string"
    },
    {
      "key": "session",
      "value": "demo",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Look around",
      "description": "",
      "item": [
        {
          "name": "is the plugin loaded",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/_cat/plugins?v",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_cat",
                "plugins"
              ],
              "query": [
                {
                  "key": "v",
                  "value": null
                }
              ]
            },
            "description": "The plugin shows up as nlsearch with the version it was built for. If this is empty the node did not load it; the log says why."
          },
          "response": []
        },
        {
          "name": "what indices are there",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/_cat/indices?v",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_cat",
                "indices"
              ],
              "query": [
                {
                  "key": "v",
                  "value": null
                }
              ]
            },
            "description": "Ordinary Elasticsearch. Useful before and after the requests that change things."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Set up something to play with",
      "description": "",
      "item": [
        {
          "name": "create an index",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "create_index. The model picks the field types: text with a keyword sub-field for the name, keyword for the category, float, boolean, date.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"create an index called products with a name, a category, a price, whether it is in stock and the date it was added\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "add one product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "index. No id was given so Elasticsearch makes one up, and the response comes back 201 like the normal index API.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"add a product called Red Running Shoe in category shoes, price 49.9, in stock, added today\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "add several products",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "bulk. One request, several documents.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"add these products: Blue Mug in kitchen for 12.5 in stock, Black Kettle in kitchen for 35 out of stock, Green Sandal in shoes for 20 in stock, Office Chair in furniture for 120 in stock\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "What you get back",
      "description": "",
      "item": [
        {
          "name": "the default, both",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "Send nothing for \"response\" and you get both halves:\n\n  \"response\"  a sentence a person can read, written by the model from what Elasticsearch returned\n  \"result\"    the Elasticsearch response itself\n\nA chat bot usually wants exactly this: show the sentence, keep the data for the table underneath.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"how many products are out of stock\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "explain, the sentence on its own",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "\"response\": \"explain\" drops \"result\" and leaves the sentence. Good when the answer goes straight to a person and nothing is going to read the data.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"how many products are out of stock\",\n  \"response\": \"explain\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "raw, the data on its own",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "\"response\": \"raw\" gives you \"result\" and nothing else: exactly what Elasticsearch answered, and no second call to the model, so it is the fastest of the three.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"how many products are out of stock\",\n  \"response\": \"raw\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "a sentence about a list",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "The explanation names the real items and prices out of the response. It never invents a value, and when a search finds nothing it says so.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"the three cheapest things in stock\",\n  \"response\": \"explain\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "quoting something to be exact",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "Text in quotes is taken literally: the same capitals, the same spacing, the same words. Use it when you want one specific thing rather than whatever the words happen to match.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"how many 'Red Running Shoe' are there in stock\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Searching",
      "description": "",
      "item": [
        {
          "name": "plain search",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "A full text match on the name and a range filter on the price, in one bool query.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"red shoes under 50\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "a condition on a keyword field",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "Words that are values of a keyword field become term filters rather than a text search.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"kitchen stuff thats actually in stock\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "search without naming the index",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "Nothing in the sentence names an index, a field or a value. The model works out all three from the mappings and the sample documents it is shown.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"anything going for less than 30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Counting and grouping",
      "description": "",
      "item": [
        {
          "name": "how many",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "A search with size 0; the count comes back in hits.total.value.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"how many products are out of stock\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "count per group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "A terms aggregation. Results are under result.aggregations.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"how many products are there in each category\"\n}",
              "options": {
                "raw": {
