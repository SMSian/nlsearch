    {
      "name": "Settings",
      "description": "",
      "item": [
        {
          "name": "see the settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/_cluster/settings?include_defaults=false",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_cluster",
                "settings"
              ],
              "query": [
                {
                  "key": "include_defaults",
                  "value": "false"
                }
              ]
            },
            "description": "The API key is filtered out of this and of the nodes API."
          },
          "response": []
        },
        {
          "name": "switch model",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_cluster/settings",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_cluster",
                "settings"
              ]
            },
            "description": "Takes effect on the next request, no restart. Provider, model, url, api_key and timeout can all be changed this way.\n\nllama3.2:3b is a 3B model and a fair look at the lower limit: it answers single questions but loses the thread on follow-ups.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transient\": {\n    \"nlsearch.model\": \"llama3.2:3b\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "use a hosted model",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_cluster/settings",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_cluster",
                "settings"
              ]
            },
            "description": "provider openai also covers anything with an OpenAI compatible API: Groq, Together, DeepSeek, OpenRouter, LM Studio, vLLM. Point nlsearch.url at it.\n\nMIND THIS ONE. The key here is a placeholder, and persistent settings survive a restart, so until you run the request below every request will fail with an invalid key.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"persistent\": {\n    \"nlsearch.provider\": \"openai\",\n    \"nlsearch.model\": \"gpt-4o-mini\",\n    \"nlsearch.api_key\": \"sk-...\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "put everything back",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_cluster/settings",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_cluster",
                "settings"
              ]
            },
            "description": "Null clears an override, so the node falls back to elasticsearch.yml. Clearing both halves leaves the node exactly as it was before this folder, which is why this request is last.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"persistent\": {\n    \"nlsearch.provider\": null,\n    \"nlsearch.model\": null,\n    \"nlsearch.url\": null,\n    \"nlsearch.api_key\": null,\n    \"nlsearch.timeout\": null\n  },\n  \"transient\": {\n    \"nlsearch.provider\": null,\n    \"nlsearch.model\": null,\n    \"nlsearch.url\": null,\n    \"nlsearch.api_key\": null,\n    \"nlsearch.timeout\": null\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    }
  ]
