              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "A terms aggregation with an avg inside it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"average price per category\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Ordering",
      "description": "",
      "item": [
        {
          "name": "cheapest first",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "sort plus size. Ask for an order and you get a sort; ask for a number and you get a size.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"show the 3 cheapest products\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "the single best",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "A superlative becomes a sort with size 1. It uses price because that is a field this collection actually creates; ask for the best rated and you get an honest error, since nothing here has a rating.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"whats the most expensive thing we sell\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Chat bots: sessions and history",
      "description": "",
      "item": [
        {
          "name": "1 - start a conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "Everything in this folder sends the same session, set in the collection variables. That one field is all a bot needs: nothing to open, nothing to close.\n\nRun these five in order and watch the body field change rather than reset.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"show me shoes\",\n  \"session\": \"{{session}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "2 - narrow it down",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "\"the ones\" only means something because of the previous turn. The model starts from its own previous query and adds a filter.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"only the ones in stock\",\n  \"session\": \"{{session}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "3 - change the order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "Still the same query, now with a sort. Each turn keeps what came before.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"cheapest first\",\n  \"session\": \"{{session}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "4 - and a limit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "Adds a size. Three turns of context, all from one session string.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"just the top two\",\n  \"session\": \"{{session}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "5 - a pronoun that would delete things",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "dry_run is on, so this only shows the plan. Note that \"those\" resolves to the query built up over the previous turns. Run anything destructive this way first.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"delete those\",\n  \"session\": \"{{session}}\",\n  \"dry_run\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "the same question with no session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "The same sentence as turn 2, without a session. There is nothing to refer back to, so the model has to guess. This is the difference the session makes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"only the ones in stock\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "read the stored history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/.nlsearch-history/_doc/{{session}}",
              "host": [
                "{{host}}"
              ],
              "path": [
                ".nlsearch-history",
                "_doc",
                "{{session}}"
              ]
            },
            "description": "One document per session, holding the last 10 turns. Each turn is the prompt, the JSON the model answered with, and the outcome.\n\nThe outcome line is what makes follow-ups work: after a search it carries the ids and names of the first hits, so a later \"make it 22\" knows which document is meant. After a failure it carries the error so the model can correct itself.\n\nThe index is created on the first request that carries a session, so this returns 404 until then."
          },
          "response": []
        },
        {
          "name": "which conversations exist",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/.nlsearch-history/_search?size=50&_source=updated",
              "host": [
                "{{host}}"
              ],
              "path": [
                ".nlsearch-history",
                "_search"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "50"
                },
                {
                  "key": "_source",
                  "value": "updated"
                }
              ]
            },
            "description": "The index is an ordinary one, so you can look through it, snapshot it, or expire old conversations with an ILM policy."
          },
          "response": []
        },
        {
          "name": "expire old conversations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/.nlsearch-history/_delete_by_query",
              "host": [
                "{{host}}"
              ],
              "path": [
                ".nlsearch-history",
                "_delete_by_query"
              ]
            },
            "description": "Nothing expires by itself. If you run many short conversations, put something like this on a schedule.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": {\n    \"range\": {\n      \"updated\": {\n        \"lt\": \"now-30d\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "forget this conversation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{host}}/.nlsearch-history/_doc/{{session}}",
              "host": [
                "{{host}}"
              ],
              "path": [
                ".nlsearch-history",
                "_doc",
                "{{session}}"
              ]
            },
            "description": "The next request with this session starts clean."
          },
          "response": []
        },
        {
          "name": "forget every conversation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{host}}/.nlsearch-history",
              "host": [
                "{{host}}"
              ],
              "path": [
                ".nlsearch-history"
              ]
            },
            "description": "The index is recreated, hidden, on the next request that carries a session."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Writing",
      "description": "",
      "item": [
        {
          "name": "update one document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/_nl",
              "host": [
                "{{host}}"
              ],
              "path": [
                "_nl"
              ]
            },
            "description": "There is no id here, only a description, so this has to become an update_by_query whose query finds the mug. Give a real id instead (\"set the price of product 1 to 14\") and it becomes a plain update.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"set the price of the Blue Mug to 14\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
