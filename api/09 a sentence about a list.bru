meta {
  name: 09 a sentence about a list
  type: http
  seq: 9
}

post {
  url: {{host}}/_nl
  body: json
  auth: inherit
}

body:json {
  {
    "prompt": "the three cheapest things in stock",
    "response": "explain"
  }
}

docs {
  What you get back - a sentence about a list

  The explanation names the real items and prices out of the response. It never invents a value, and when a search finds nothing it says so.
}
