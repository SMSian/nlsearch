meta {
  name: 31 expire old conversations
  type: http
  seq: 31
}

post {
  url: {{host}}/.nlsearch-history/_delete_by_query
  body: json
  auth: inherit
}

body:json {
  {
    "query": {
      "range": {
        "updated": {
          "lt": "now-30d"
        }
      }
    }
  }
}

docs {
  Chat bots: sessions and history - expire old conversations

  Nothing expires by itself. If you run many short conversations, put something like this on a schedule.
}
