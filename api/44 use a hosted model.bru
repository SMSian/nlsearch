meta {
  name: 44 use a hosted model
  type: http
  seq: 44
}

put {
  url: {{host}}/_cluster/settings
  body: json
  auth: inherit
}

body:json {
  {
    "persistent": {
      "nlsearch.provider": "openai",
      "nlsearch.model": "gpt-4o-mini",
      "nlsearch.api_key": "sk-..."
    }
  }
}

docs {
  Settings - use a hosted model

  provider openai also covers anything with an OpenAI compatible API: Groq, Together, DeepSeek, OpenRouter, LM Studio, vLLM. Point nlsearch.url at it.

  MIND THIS ONE. The key here is a placeholder, and persistent settings survive a restart, so until you run the request below every request will fail with an invalid key.
}
